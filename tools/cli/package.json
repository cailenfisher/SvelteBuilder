{
  "name": "@sveltebuilder/cli",
  "version": "0.0.13",
  "description": "CLI for ongoing SvelteBuilder project management — syncs Drizzle schemas from installed modules into Supabase migrations and seed data.",
  "keywords": [
    "cli",
    "sveltekit",
    "svelte",
    "drizzle",
    "supabase",
    "migrations",
    "schema",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "sveltebuilder": "./dist/index.js"
  },
  "exports": {
    "./api": "./dist/api.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "@sveltebuilder/hermes-schema": "workspace:^",
    "commander": "^12.0.0",
    "drizzle-kit": "^0.29.0",
    "glob": "^11.0.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
