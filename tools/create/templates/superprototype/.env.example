PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Direct Postgres connection string for Drizzle (session pooler or direct).
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# If your environment doesn't support IPv6, use the Supavisor session mode connection string instead:
# Supavisor session mode (IPv4-compatible, port 5432) for Drizzle.
# Username must carry the project ref: postgres.<ref>
# Example: postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=your_supabase_db_url
PUBLIC_DEFAULT_LOCALE=en
PUBLIC_SITE_URL=http://localhost:5173
