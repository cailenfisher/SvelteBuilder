# Local development (pnpm db:start, i.e. `supabase start`):
#   Run `pnpm db:start` (or `supabase status` once it's already running) and copy its
#   "API URL" / "anon key" / "service_role key" output into the three values below.
#   DATABASE_URL for local Supabase is always:
#     postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Hosted Supabase project — from Project Settings > API / Database instead:
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Direct Postgres connection string for Drizzle (session pooler or direct).
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# If your environment doesn't support IPv6, use the Supavisor session mode connection string instead:
# Supavisor session mode (IPv4-compatible, port 5432) for Drizzle.
# Username must carry the project ref: postgres.<ref>
# Example: postgresql://postgres.<ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=your_supabase_db_url

# Required to sign in at all — the scaffold's only auth method is Google OAuth.
# Without these, the public route and the read-only /api/* endpoints still work
# locally, but everything under (admin) redirects to /sign-in and stays out of reach.
# See supabase/config.toml [auth.external.google] and README.md "Local development".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PUBLIC_DEFAULT_LOCALE=en
PUBLIC_SITE_URL=http://localhost:5173
