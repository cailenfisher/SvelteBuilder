# Database — direct Postgres connection string for Drizzle
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=your_database_url

# Auth.js — required for all deployments
AUTH_SECRET=generate_with_openssl_rand_base64_32
# Set to true in production behind a trusted proxy (Vercel, Cloudflare, etc.)
# AUTH_TRUST_HOST=true

# Microsoft Entra ID (Azure AD) OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=your_entra_client_id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your_entra_client_secret
# Tenant-specific issuer URL: https://login.microsoftonline.com/{tenant-id}/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Google OAuth
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# GitHub OAuth
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

PUBLIC_DEFAULT_LOCALE=en
PUBLIC_SITE_URL=http://localhost:5173
