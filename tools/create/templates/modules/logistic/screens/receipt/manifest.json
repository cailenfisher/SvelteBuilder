{
  "id": "receipt",
  "module": "logistic",
  "label": "Inbound receipts",
  "hint": "Receiving against a supplier or blind, line by line, with stock moved as goods land",
  "routes": ["/admin/logistic/receipt", "/admin/logistic/receipt/[id]"],
  "requires": [],
  "views": [
    "InboundReceiptListView",
    "InboundReceiptDetailView",
    "InboundReceiptRow",
    "InboundReceiptLineRow"
  ],
  "actions": {
    "/admin/logistic/receipt": {
      "create": ["supplier_id", "expected_at", "note"]
    },
    "/admin/logistic/receipt/[id]": {
      "addLine": ["storage_location_id", "sku", "expected_quantity"],
      "receiveLine": ["line_id", "received_quantity"]
    }
  },
