{
  "id": "warehouse",
  "module": "logistic",
  "label": "Warehouse floor app",
  "hint": "The worker-facing app: pick queue, receiving and counting, on its own layout — one bundle, since its navigation links to all three",
  "routes": [
    "/warehouse",
    "/warehouse/pick-task",
    "/warehouse/pick-task/[id]",
    "/warehouse/inbound-receipt",
    "/warehouse/inbound-receipt/[id]",
    "/warehouse/cycle-count",
    "/warehouse/cycle-count/[id]"
  ],
  "requires": [],
  "views": [
    "WarehouseShellView",
    "PickTaskWarehouseQueueView",
    "PickTaskWarehouseDetailView",
    "PickTaskLineRow",
    "InboundReceiptWarehouseQueueView",
    "InboundReceiptWarehouseDetailView",
    "CycleCountWarehouseQueueView",
    "CycleCountWarehouseDetailView"
  ],
  "actions": {
    "/warehouse/pick-task": {
      "take": ["pick_task_id"]
    },
    "/warehouse/pick-task/[id]": {
      "pick": ["pick_task_line_id", "quantity"],
      "complete": []
    },
    "/warehouse/inbound-receipt/[id]": {
      "receive": ["inbound_receipt_line_id", "quantity"]
    },
    "/warehouse/cycle-count": {
      "take": ["cycle_count_id"]
    },
    "/warehouse/cycle-count/[id]": {
      "record": ["cycle_count_line_id", "quantity"]
    }
  },
