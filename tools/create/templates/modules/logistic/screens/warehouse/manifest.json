{
  "id": "warehouse",
  "module": "logistic",
  "label": "Warehouse floor app",
  "hint": "The worker-facing app: pick queue, receiving and counting, on its own layout — one bundle, since its nav links to all three",
  "routes": [
    "/warehouse",
    "/warehouse/pick",
    "/warehouse/pick/[id]",
    "/warehouse/receive",
    "/warehouse/receive/[id]",
    "/warehouse/count",
    "/warehouse/count/[id]"
  ],
  "requires": [],
  "views": [
    "WarehouseShellView",
    "PickQueueView",
    "PickTaskDetailView",
    "PickTaskLineRow",
    "ReceiveQueueView",
    "ReceiveDetailView",
    "CountQueueView",
    "CountDetailView"
  ],
  "actions": {
    "/warehouse/pick": {
      "take": ["task_id"]
    },
    "/warehouse/pick/[id]": {
      "pick": ["line_id", "quantity"],
      "complete": []
    },
    "/warehouse/receive/[id]": {
      "receive": ["line_id", "quantity"]
    },
    "/warehouse/count": {
      "take": ["count_id"]
    },
    "/warehouse/count/[id]": {
      "record": ["line_id", "quantity"]
    }
  },
