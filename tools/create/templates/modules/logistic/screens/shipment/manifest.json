{
  "id": "shipment",
  "module": "logistic",
  "label": "Shipments",
  "hint": "Outbound shipments with carrier details, status transitions and a tracking event log",
  "routes": ["/admin/logistic/shipment", "/admin/logistic/shipment/[id]"],
  "requires": [],
  "views": ["ShipmentListView", "ShipmentDetailView", "ShipmentRow"],
