{
  "id": "article-admin",
  "module": "content",
  "label": "Article admin",
  "hint": "The newsroom side: every article at every status, the publish checklist, and workflow transitions",
  "routes": ["/admin/content/article", "/admin/content/article/[id]"],
  "requires": [],
  "views": ["ArticleAdminListView", "ArticleAdminDetailView", "ArticleChecklistEntry", "ArticleRow"],
  "actions": {
    "/admin/content/article": {
      "create": ["headline", "canonical_slug"]
    },
    "/admin/content/article/[id]": {
      "transition": ["status_slug"],
      "checklist": ["item_id", "satisfied"]
    }
  },
  "copySlugs": [
    "content.article_admin.article",
    "content.article_admin.new",
    "content.article_admin.create",
    "content.article_admin.headline",
    "content.article_admin.slug",
    "content.article_admin.filter_all",
    "content.article_admin.filter_status",
    "content.article_admin.body",
    "content.article_admin.filing",
    "content.article_admin.section",
    "content.article_admin.article_byline",
    "action.cancel",
    "action.close"
  ]
}
