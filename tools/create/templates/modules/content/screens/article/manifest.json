{
  "id": "article",
  "module": "content",
  "label": "Article page",
  "hint": "The public article page: body blocks, bylines, comments, OG/Twitter meta and NewsArticle JSON-LD",
  "routes": ["/article/[slug]"],
  "requires": [],
  "views": ["ArticleDetailView", "ArticleWithBlocks", "ArticleRow"],
  "actions": {
    "/article/[slug]": {
      "comment": ["author_name", "author_email", "body"]
    }
  },
  "copySlugs": [
    "content.comment.heading",
    "content.comment.leave",
    "content.comment.name",
    "content.comment.email",
    "content.comment.body",
    "content.comment.submit",
    "content.comment.pending"
  ]
}
