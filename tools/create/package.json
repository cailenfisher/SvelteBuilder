  "description": "Scaffold a production-ready SvelteKit app with SvelteBuilder — i18n, accessible UI components, and domain modules, pre-wired to Supabase or Drizzle.",
  "keywords": [
    "sveltekit",
    "svelte",
    "svelte5",
    "scaffold",
    "starter",
    "boilerplate",
    "create",
    "template",
    "supabase",
    "drizzle",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-sveltebuilder": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@sveltebuilder/cli": "workspace:^",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
