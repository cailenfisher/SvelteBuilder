{
  "name": "@sveltebuilder/content",
  "version": "0.1.0",
  "description": "Publisher/news domain module for SvelteBuilder — articles, sections, taxonomy, live coverage, newsletters, comments, RSS, sitemaps, and JSON-LD, with a Drizzle schema and i18n built in.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "cms",
    "publishing",
    "blog",
    "news",
    "articles",
    "rss",
    "sitemap",
    "json-ld",
    "drizzle",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "svelte-package -i src/lib",
    "dev": "svelte-package -i src/lib --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "default": "./dist/publishing/index.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "diglossia": "^0.1.0",
    "@sveltebuilder/coreui": "workspace:^",
    "@supabase/supabase-js": ">=2.0.0",
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "diglossia": "link:../../../diglossia",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
