{
  "name": "@sveltebuilder/access",
  "version": "0.0.0",
  "description": "Roles and permissions for SvelteBuilder \u2014 permissions, roles, groups and role assignments at global, scope or single-row targets, enforced by Postgres row level security.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "access-control",
    "permissions",
    "roles",
    "rbac",
    "row-level-security",
    "drizzle",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "svelte-package -i src/lib",
    "dev": "svelte-package -i src/lib --watch",
    "lint": "eslint src",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/components.css": "./dist/components.css",
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@sveltebuilder/coreui": "workspace:^",
    "diglossia": "^0.2.0",
    "svelte": ">=5.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "diglossia": "^0.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
