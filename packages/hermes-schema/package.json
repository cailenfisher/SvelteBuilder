{
  "name": "@sveltebuilder/hermes-schema",
  "version": "0.0.7",
  "description": "Drizzle table definitions and seed data for SvelteBuilder's core i18n tables — locale, local_text_link, local_text.",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgres",
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "schema",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
