{
  "name": "@sveltebuilder/coreui",
  "version": "0.2.2",
  "description": "Accessible Svelte 5 UI component library built on Bits UI — buttons, forms, tables, dialogs, menus, and more, with a themeable CSS layer system.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "ui",
    "ui-library",
    "component-library",
    "design-system",
    "bits-ui",
    "accessibility",
    "a11y",
    "wcag",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "svelte-package",
    "dev": "svelte-package --watch",
    "lint": "eslint src",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/components.css": "./styles/components.css"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "bits-ui": "^2.18.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "diglossia": "^0.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
