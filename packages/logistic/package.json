{
  "name": "@sveltebuilder/logistic",
  "version": "1.0.0",
  "description": "Warehouse and logistics domain module for SvelteBuilder — suppliers, storage locations, stock, receiving, pick tasks, shipments, returns, and cycle counts, with a Drizzle schema and i18n built in.",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "logistics",
    "warehouse",
    "wms",
    "inventory",
    "shipping",
    "fulfillment",
    "supply-chain",
    "drizzle",
    "sveltebuilder"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "svelte-package -i src/lib",
    "dev": "svelte-package -i src/lib --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "default": "./dist/views.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "@sveltebuilder/local-text-schema": "workspace:^"
  },
  "peerDependencies": {
    "diglossia": "^0.2.0",
    "@sveltebuilder/coreui": "workspace:^",
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "diglossia": "^0.2.0",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
