{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "rootDirs": [".", "./.svelte-kit/types"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.svelte",
    ".svelte-kit/types/**/*.ts"
  ]
}
